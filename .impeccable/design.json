  "narrative": {
    "northStar": "Open Journal",
    "overview": "Open Journal brings photographs and writing into one airy editorial experience. Original photography supplies the visual presence; a white field, muted green accents, and generous margins give it room. The serif introduction and reading text feel personal, while sans serif story headings and navigation keep browsing clear.\n\nThe system is quiet and flat. Rectangular images, fine rules, and typographic contrast organize the page without ornamental containers. The journal and reading layouts share these materials while allowing their own composition.",
    "keyCharacteristics": [
      "Dominant original photography on a white field.",
      "Local serif reading text paired with sans serif headings.",
      "Muted green links, fine dividers, and square geometry.",
      "Airy browsing and a bounded long-form reading column."
    ],
    "rules": [
      {
        "name": "The Quiet Accent Rule",
        "body": "Use muted green for links, selected filters, and focus; let photography supply the broad color fields.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Source Serif for personal introductions and sustained reading, and DM Sans for story headings and interface text.",
        "section": "typography"
      },
      {
        "name": "The Flat Ground Rule",
        "body": "Separate the editorial surfaces with whitespace, fine rules, and tonal ground rather than shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain original photographs and descriptive alternative text.",
      "Do use the shared focus outline and visible selected states.",
      "Do keep the desktop welcome panel fully inset and vertically centered, then put the introduction below the photograph on mobile.",
      "Do preserve authored reading content, captions, embeds, and optional contents navigation."
    ],
    "donts": [
      "Don't replace the white field and restrained green accents with ornamental surface treatments.",
      "Don't wrap journal stories in raised, rounded cards.",
      "Don't promote preserved legacy gallery styling into defaults for new editorial surfaces.",
      "Don't treat the preview tonal ramps as shipped palette tokens."
    ]
  }
